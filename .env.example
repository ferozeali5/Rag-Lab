# Rename this file to .env and fill in real values. Never commit .env.

# Supabase project (Settings -> Database -> Connection string, use the "Session" or direct connection, port 5432)
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# Supabase API (Settings -> API) - only needed if you switch to the supabase-py client instead of raw psycopg2
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Anthropic (for the "ask a question" generation step)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (Anthropic's recommended embeddings partner - voyage-2 outputs 1024 dims, matching the vector(1024) column)
# Get a free key at https://dash.voyageai.com/
VOYAGE_API_KEY=pa-...
